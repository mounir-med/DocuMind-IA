# Copiez ce fichier en backend/.env puis redémarrez le backend.
# Les noms ci-dessous correspondent exactement aux champs de app/core/config.py.

# ── LLM (OBLIGATOIRE pour avoir de vraies réponses et des QCM) ──────────────
# Valeurs : ollama | openai | demo (demo = AUCUNE génération IA)
LLM_PROVIDER=ollama

# Option A : Ollama local (gratuit). Lancez d'abord :  ollama pull llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest

# Option B : OpenAI (ou API compatible). Mettez LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=llama3.1:latest
LLM_TEMPERATURE=0.2

# ── Embeddings / RAG ────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.25
CHUNK_SIZE=520
CHUNK_OVERLAP=90

# ── Divers ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
